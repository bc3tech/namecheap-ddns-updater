{
  "name": "Digital Twin Dev Container",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "configureZshAsDefaultShell": false,
      "installZsh": false,
      "upgradePackages": false,
      "username": "vscode"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/copilot-cli:1": {},
    "ghcr.io/devcontainers/features/azure-cli:1": {},
    "ghcr.io/azure/azure-dev/azd:latest": {},
    "ghcr.io/devcontainers/features/powershell:2": {},
    "ghcr.io/devcontainers/features/node:2": {
      "version": "lts"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-azuretools.vscode-azureresourcegroups",
        "ms-azuretools.vscode-bicep",
        "github.copilot",
        "github.copilot-chat",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "pwsh"
      }
    }
  },
  "mounts": [
    "source=${localWorkspaceFolder}/.devcontainer/gitconfig.effective,target=${containerWorkspaceFolder}/.devcontainer/gitconfig.effective,type=bind,consistency=cached",
    "source=${localEnv:COPILOT_HOME:${localEnv:HOME}/.copilot},target=/home/vscode/.copilot,type=bind,consistency=cached",
    "source=${localEnv:CARGO_HOME},target=/opt/host-caches/CARGO_HOME,type=bind,consistency=cached",
    "source=${localEnv:COPILOT_HOME},target=/opt/host-caches/COPILOT_HOME,type=bind,consistency=cached",
    "source=${localEnv:npm_config_cache},target=/opt/host-caches/npm_config_cache,type=bind,consistency=cached",
    "source=${localEnv:NUGET_PACKAGES},target=/opt/host-caches/NUGET_PACKAGES,type=bind,consistency=cached",
    "source=${localEnv:PIP_CACHE_DIR},target=/opt/host-caches/PIP_CACHE_DIR,type=bind,consistency=cached",
    "source=${localEnv:VCPKG_DEFAULT_BINARY_CACHE},target=/opt/host-caches/VCPKG_DEFAULT_BINARY_CACHE,type=bind,consistency=cached",
    "source=${localEnv:XDG_DATA_HOME},target=/opt/host-caches/XDG_DATA_HOME,type=bind,consistency=cached"
  ],
  "containerEnv": {
    "POWERSHELL_DISTRIBUTION_CHANNEL": "DevContainers",
    "CARGO_HOME": "/opt/host-caches/CARGO_HOME",
    "COPILOT_HOME": "/opt/host-caches/COPILOT_HOME",
    "npm_config_cache": "/opt/host-caches/npm_config_cache",
    "NUGET_PACKAGES": "/opt/host-caches/NUGET_PACKAGES",
    "PIP_CACHE_DIR": "/opt/host-caches/PIP_CACHE_DIR",
    "VCPKG_DEFAULT_BINARY_CACHE": "/opt/host-caches/VCPKG_DEFAULT_BINARY_CACHE",
    "XDG_DATA_HOME": "/opt/host-caches/XDG_DATA_HOME",
    "COPILOT_CACHE_HOME": "/opt/host-caches/COPILOT_HOME/cache"
  },
  "postCreateCommand": "bash .devcontainer/scripts/bootstrap-ghcp-digital-twin.sh",
  "postStartCommand": "bash .devcontainer/scripts/apply-global-git-config.sh .devcontainer/gitconfig.effective",
  "remoteUser": "vscode"
}
